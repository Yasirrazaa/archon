# Archon Environment Configuration
# Copy this file to .env and fill in your API keys

# LLM Provider (OpenAI-compatible)
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1

# Model Configuration (uses Groq with gpt-oss-20b for competition)
ATTACKER_MODEL=openai/gpt-oss-20b
DEFENDER_MODEL=openai/gpt-oss-20b
NORMAL_USER_MODEL=openai/gpt-oss-20b

# Alternative: Use OpenAI directly
# ATTACKER_MODEL=gpt-4o-mini
# DEFENDER_MODEL=gpt-4o-mini
# NORMAL_USER_MODEL=gpt-4o-mini

# Agent Timeouts
AGENT_TIMEOUT_SECONDS=300
NORMAL_USER_MAX_ATTEMPTS=3

# Logging
LOG_LEVEL=INFO